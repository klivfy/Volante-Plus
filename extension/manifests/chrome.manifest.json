{
  "manifest_version": 3,
  "name": "Volante+",
  "short_name": "Volante+",
  "version": "2.0.0",
  "description": "Gera jogos de loterias (Mega-Sena, +Milionária) direto da barra de ferramentas, com sincronização de novos sorteios em segundo plano.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://loteriascaixa-api.herokuapp.com/*",
    "https://guidi.dev.br/*",
    "https://servicebus2.caixa.gov.br/*"
  ]
}

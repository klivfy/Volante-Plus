{
  "manifest_version": 3,
  "name": "Volante+",
  "short_name": "Volante+",
  "version": "2.0.0",
  "description": "Atalho para abrir o Volante+ (análise e geração de jogos de loterias com backtesting) numa aba.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options.html",
  "permissions": ["storage"]
}

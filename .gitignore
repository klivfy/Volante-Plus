# Gradle files
.gradle/
build/

# Cache do compilador Kotlin
.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# extension (gerado por extension/build.mjs)
extension/dist/
extension/.background-build.js
extension/node_modules/
extension/popup-app/node_modules/
extension/popup-app/.next/
extension/popup-app/out/
extension/popup-app/tsconfig.tsbuildinfo

# Release build artifacts (regenerated on deployment)
release/web/.next/
release/web/workbox-*.js
release/web/workbox-*.js.map

# Keystore credentials (arquivo local; ver keystore.properties.example)
keystore.properties

# Netlify CLI (estado local de `netlify link`/`netlify deploy`, roda a
# partir da raiz — é aqui que `netlify.toml` vive)
.netlify

# Pacote temporário que o @netlify/mcp gera na raiz do repo ao empacotar um
# deploy (não é um artefato do projeto, some sozinho ao final do deploy)
/deploy-*.zip

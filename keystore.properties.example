# Copie este arquivo para keystore.properties (que fica fora do git)
# e preencha com as credenciais reais do keystore de release.
# Alternativa: defina as variáveis de ambiente VOLANTEPLUS_STORE_FILE,
# VOLANTEPLUS_STORE_PASSWORD, VOLANTEPLUS_KEY_ALIAS e
# VOLANTEPLUS_KEY_PASSWORD (útil em CI, ex.: GitHub Actions secrets).
storeFile=caminho/para/o/volanteplus-release.keystore
storePassword=
keyAlias=volanteplus
keyPassword=

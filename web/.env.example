# API pública de resultados/próximos concursos das loterias (comunidade, não é
# o serviço oficial da Caixa): https://github.com/guto-alves/loterias-api
NEXT_PUBLIC_CAIXA_API_BASE_URL=https://loteriascaixa-api.herokuapp.com/api

# --- Notificações push (opcional) ---
# Gere um par de chaves VAPID com: npx web-push generate-vapid-keys
# A chave pública é exposta ao cliente (prefixo NEXT_PUBLIC_) para inscrever o
# navegador; a privada fica só no servidor (funções serverless de /api/push).
# Sem estas variáveis, o app funciona normalmente — só o opt-in de push some.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@volante.plus

# Segredo compartilhado para autorizar POST /api/push/send (disparo de push a
# todos os inscritos, ex.: via Vercel Cron). Se vazio, o endpoint fica aberto —
# defina em produção.
PUSH_SEND_SECRET=

# --- Plausible Analytics (opcional) ---
# Domínio para o qual registrar eventos (ex.: volante.plus).
# Deixar vazio desativa Plausible completamente.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Host da API do Plausible (padrão: https://plausible.io/js/script.js).
# Use para self-hosted Plausible ou proxies customizados.
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io/js/script.js
